# Cloudinary production media storage
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-side AI credentials — never expose these as NEXT_PUBLIC_ variables.
GEMINI_API_KEY=
HUGGING_FACE_TOKEN=
OPENROUTER_API_KEY=
POLLINATIONS_SECRET_KEY=

# Fast live web search providers — server-side only
PARALLEL_API_KEY=
TAVILY_API_KEY=

# Dedicated Gemini image generation — server-side only
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional LiveKit calling credentials. Calling stays disabled when unset.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
